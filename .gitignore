# Miscellaneous
*.class
*.log
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.venv/
venv/
node_modules/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.env
.env.*
!.env.example

# Build-time configuration consumed by --dart-define-from-file.
# These files contain real project keys and must NEVER be committed.
# Only the tracked templates env/*.json.example are shared.
env/*.json

# Local AI/editor tool configuration. `.antigravity/mcp.json` holds an
# `mcpServers.supabase.env.SUPABASE_SERVICE_ROLE_KEY` slot — a secret-shaped
# variable — so this folder must never be committed even when the value
# currently stored there is only the publishable key.
.antigravity/

# Claude Code local state. `.claude/skills/` IS tracked (loyiha bilimi),
# lekin `.claude/worktrees/` — vaqtinchalik git worktree'lar: har biri butun
# Flutter loyihasining nusxasi, `git worktree list` da alohida ro'yxatga olingan.
# Ularni commit qilish repo'ni ikki marta kattalashtiradi.
.claude/worktrees/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/devtools_options.yaml
/test-results/
/playwright-report/
/tool/logs/

# Gradle/Android build output (not covered by the root `/build/` rule).
android/.gradle/
android/build/
android/app/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Supabase CLI lokal holati — `linked-project.json` PROJECT REF ni saqlaydi.
# Ref repo'ga tushmasligi kerak (shu sababli `supabase/config.toml` ham yo'q).
supabase/.temp/
**/supabase/.temp/

# Qurilmadagi runtime evidence (screenshot/logcat) — CLAUDE.md §5 talab qiladigan
# isbot. Repo'ga TUSHMAYDI: (a) hajmi katta, (b) ekranda foydalanuvchi kiritgan
# matn va sessiya holati ko'rinadi, (c) evidence har bir build uchun QAYTA
# olinishi shart — eski screenshot yangi test isboti bo'lolmaydi.
.runtime_evidence/

# Biznes/investitsiya hujjatlari (binar `.docx`/`.pdf`) — kodga aloqasi yo'q,
# diff'i o'qilmaydi va tarixni behuda kattalashtiradi. Ular alohida joyda
# (Drive/Notion) saqlanadi.
*.docx
*.pdf
*.doc
*.ppt
*.pptx
*.xls
*.xlsx
/exports/

# Local credentials, signing material, database copies and browser sessions.
# Public certificates may be tracked; private keys must not be.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
**/key.properties
**/credentials.json
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
/backups/
/dumps/
.vercel/
playwright/.auth/
**/.auth/
**/storage-state*.json
env/**/*.json

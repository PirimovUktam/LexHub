{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lexhub-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5044",
        "--dart-define-from-file=env/prod.json"
      ],
      "port": 5044
    },
    {
      "name": "lexhub-release-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8011",
        "--directory",
        "build/web"
      ],
      "port": 8011
    }
  ]
}
